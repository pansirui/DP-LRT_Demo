clear all
close all
clc
load('kerry_2D_400_150.mat')


% Requirements: RSF (http://rsf.sourceforge.net/) with Matlab API

% Synthetic data for footprint noise removal


d=kerry_2D_400_150;
figure;imagesc(d');title('ori')

%% denoise via dictionary learning
l1=8;l2=8;s1=4;s2=4;
c1=8;c2=16;%size of the 1D cosine dictionary (if c2>c1, overcomplete)
%% DCT dictionary (dctmtx will generates orthogonal transform)  
%DCT字典（dctmtx将生成正交变换）
dct=zeros(c1,c2);
for k=0:1:c2-1
    V=cos([0:1:c1-1]'*k*pi/c2);
    if k>0
        V=V-mean(V);
    end
    dct(:,k+1)=V/norm(V);
end
DCT=kron(dct,dct);%2D DCT dictionary (64,256)

%% Denoising by KSVD
%param naming following Chen, 2017, GJI; Zhou et al., 2020
K=64;
param.T=3;      %sparsity level
param.D=DCT;    %initial D
param.niter=10; %number of K-SVD iterations to perform; default: 10
param.mode=1;   %1: sparsity; 0: error     不能改
%param.exact:   Exact K-SVD update or approximate
param.K=64;     %number of atoms, dictionary size
%for X=DG


%% Option 1: denoise only using the integrated function
%仅使用综合函数进行去噪
param=struct('T',3,'niter',10,'mode',1,'K',64,'D',DCT);
mode=1;l1=8;l2=8;s1=4;s2=4;perc=7;

%% compare performance of two dictionaries
%比较两部字典的性能
T=1;perc=100;       %%%perc影响不大   T为1时，相对较好
[n1,n2]=size(d);
%% residual learning
X=yc_patch(d,mode,l1,l2,s1,s2);
[D,G]=yc_ksvd(X,param);      %D学习字典  G稀疏系数    通过KSVD更新字典
% G2=yc_ompN(D,X,T);           %通过OMP更新稀疏矩阵
% X2=D*G2;
% d_residual_Learn=yc_patch_inv(X2,mode,n1,n2,l1,l2,s1,s2);
% figure;imagesc(d_residual_Learn');title('d_residual_Learn','Interpreter','none')

%% statistics guided DL     应该是论文所提算法  SGRDL
natom=K;
k=yc_var2(D,l1,l2);
[ks,ii]=sort(k,'descend');
% figure;stem(ks);   不知道画出来有啥用
% ks_ratio=[ks(1:end-1)./ks(2:end)];% ks_dif=diff(ks);figure;stem(ks_dif);
% figure;stem(ks_ratio);
perc=3;%works fine              看来这个参数可能对结果有影响   大了反而不好
% perc=90;%works perfectly? I think so.
tt=round(natom*(100-perc)/100);
inds=ii(1:tt);

% D_o1=D;
% D_o1(:,inds)=0;    绘制各种原子图
% figure('units','normalized','Position',[0.2 0.4 0.6, 0.8]);     
% for ia=1:64
%     subplot(8,8,ia);imagesc(reshape(D(:,ia),l1,l2));colormap(jet);
%     set(gca,'Linewidth',1.5,'Fontsize',16);
%     set(gca,'xticklabel',[]);set(gca,'yticklabel',[]);
% end
% 
% figure('units','normalized','Position',[0.2 0.4 0.6, 0.8]);
% for ia=1:64
%     subplot(8,8,ia);imagesc(reshape(D_o1(:,ia),l1,l2));colormap(jet);
%     set(gca,'Linewidth',1.5,'Fontsize',16);
%     set(gca,'xticklabel',[]);set(gca,'yticklabel',[]);
% end


%% filtered dictionary
DD=zeros(size(D));
for ia=1:64
    DD(:,ia)=reshape(yc_mfs(reshape(D(:,ia),l1,l2),4,1,1,4),l1*l2,1);    %mfs中值滤波
    DD(:,ia)=reshape(yc_mfs(reshape(DD(:,ia),l1,l2),4,1,2,4),l1*l2,1);
end

%% residual DL
% G22=yc_ompN([DD,D-DD],X,12);
% X22=DD*G22(1:K,:);
% d_residual_DL=yc_patch_inv(X22,mode,n1,n2,l1,l2,s1,s2);
% figure;imagesc(d_residual_DL');title('d_residual_DL','Interpreter','none')

%% residual DL + statistics guided
DD_o=D;
DD_o(:,inds)=DD(:,inds);
G22_o=yc_ompN([DD_o,D-DD_o],X,12);
X22_o=DD_o*G22_o(1:K,:);
d_SG_residual_DL=yc_patch_inv(X22_o,mode,n1,n2,l1,l2,s1,s2);
s_cplot(d_SG_residual_DL')
xlabel('Inline') 
ylabel('Crossline') 
set (gcf,'Position')
set(gca, 'Position');
d_SG_chazhi = d-d_SG_residual_DL;
% figure;imagesc(d_SG_chazhi');
% figure;imagesc(d_SG_residual_DL');title('d_SG_residual_DL','Interpreter','none')
s_cplot(d_SG_chazhi')
xlabel('Inline') 
ylabel('Crossline') 
set (gcf,'Position')
set(gca, 'Position'); % OuterPosition
caxis([-0.35,0.35])

%with mf
d_MF=yc_mfs(d',4,1,1,1);
noise_MF = d'-d_MF;
s_cplot(d_MF)
xlabel('Inline') 
ylabel('Crossline') 
set (gcf,'Position')
set(gca, 'Position');
figure;imagesc(d_MF);title('d_MF','Interpreter','none')
figure;imagesc(noise_MF);


